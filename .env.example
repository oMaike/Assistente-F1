# Fase atual
PHASE1_ONLY=true

# Portas dos microservicos
PORT=3000
GATEWAY_PORT=3000
ORCHESTRATOR_PORT=3001
KNOWLEDGE_SERVICE_PORT=3002
EXTERNAL_API_SERVICE_PORT=3003
EXPLANATION_SERVICE_PORT=3004

# URLs internas entre microservicos
ORCHESTRATOR_SERVICE_URL=http://localhost:3001
KNOWLEDGE_SERVICE_URL=http://localhost:3002
EXTERNAL_API_SERVICE_URL=http://localhost:3003
EXPLANATION_SERVICE_URL=http://localhost:3004

# RapidAPI - componente externo planejado.
# Na Fase 1 a API nao e invocada como ferramenta.
RAPIDAPI_KEY=
RAPIDAPI_HOST=f1-live-pulse.p.rapidapi.com
RAPIDAPI_BASE_URL=https://f1-live-pulse.p.rapidapi.com
RAPIDAPI_TIMEOUT_MS=7000

# Configure com os caminhos que aparecem no painel/code snippet do RapidAPI.
# Deixe vazio enquanto ainda nao escolheu os endpoints do plano basico.
F1_ENDPOINT_RACE_CONTROL=
F1_ENDPOINT_FIA_DOCUMENTS=
F1_ENDPOINT_SESSION_INFO=
F1_ENDPOINT_TIMING_DATA=/timingData
F1_ENDPOINT_DRIVER_STANDINGS=
F1_ENDPOINT_CONSTRUCTOR_STANDINGS=
F1_ENDPOINT_WEATHER=
